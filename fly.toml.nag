app = 'visual-stocker-nag'
primary_region = 'syd'

[build]

[env]
  PORT = '3000'
  SCOPES = 'read_inventory,read_locations,write_products'
  SHOPIFY_API_KEY = 'ccd4ba6230c1930e35d5907d281e0fe0'
  SHOPIFY_APP_URL = 'https://visual-stocker-nag.fly.dev'
  SHOPIFY_API_SECRET = 'd25a945dd5fc7c8599130cb6f526807f'
[processes]
  app = 'node ./dbsetup.js npm run docker-start'

[[mounts]]
  source = 'data'
  destination = '/data'
  auto_extend_size_threshold = 80
  auto_extend_size_increment = '1GB'
  auto_extend_size_limit = '10GB'

[http_service]
  internal_port = 3000
  force_https = true
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1
  processes = ['app']
  concurrency = { type = "connections", hard_limit = 25, soft_limit = 20 }

[[vm]]
  memory = '1gb'
  cpu_kind = 'shared'
  cpus = 1

[[webhooks.subscriptions]]
compliance_topics = ["customers/data_request", "customers/redact", "shop/redact"]
uri = "https://visual-stocker-nag.fly.dev/webhooks/test" 